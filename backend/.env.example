# Read automatically only when using uvicorn --env-file .env (install standard extras).
# For local development, all variables are optional; a random ignored signing key is created.
DATABASE_URL=sqlite:///./fixpath.db
# JWT_SECRET=replace-with-at-least-32-random-characters
ENVIRONMENT=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
# PostgreSQL example (not a real credential):
# DATABASE_URL=postgresql+psycopg://fixpath:your-password@localhost:5432/fixpath
